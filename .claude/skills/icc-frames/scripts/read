#!/bin/sh
# read DIR SIDE > bytes: take frames off the lanes SIDE reads and put them
# back together. The count comes first. Frames come round-robin, lane order.
set -eu
d=${1:?usage: read DIR SIDE}; s=${2:?usage: read DIR SIDE}
n=$(( $(ls "$d" | grep -c '^[0-9][0-9]*$') / 2 ))
b=$(getconf PIPE_BUF "$d")
r=$(( 1 - s ))
read -r size 0<> "$d/$r"
k=0; left=$size
while [ "$left" -gt 0 ]; do
  want=$b; [ "$left" -lt "$b" ] && want=$left
  head -c "$want" 0<> "$d/$(( (k % n) * 2 + r ))"
  left=$((left - want)); k=$((k + 1))
done
